{
  "name": "GetNewTechInfo",
  "version": "1.0.0",
  "description": "技術記事の取得・管理（RSS/Atom フィード）",
  "executable": "GetNewTechInfoCli.exe",
  "actions": [
    {
      "action": "tech_news_search",
      "prompt_hint": "技術記事表示・検索（記事を見せる・探す・一覧・表示・リスト・何件か見せて・feedの記事）",
      "prompt_example": { "action": "tech_news_search", "query": "検索語または空文字", "source": null, "sources": [], "unread": false, "limit": 10 },
      "prompt_notes": "sourceにはDevelopersIO等のソース名（feed名）を指定可。複数ソース指定ではsourcesに配列で設定し各ソースからlimit件ずつ表示。カテゴリ指定（例:「イベントのカテゴリ」）ではカテゴリ名をqueryに設定しsourceとsourcesはnullにする。limitは必ず1〜100の整数。",
      "command": { "subcommands": [], "args": [] },
      "handler": "builtin:search_tech_news",
      "display": "articles_table"
    },
    {
      "action": "tech_news_fetch",
      "prompt_hint": "技術記事取得（RSSを最新に更新・新しい記事を取ってくる・fetchして）",
      "prompt_example": { "action": "tech_news_fetch" },
      "command": { "subcommands": ["fetch"], "args": [] },
      "handler": "plugin",
      "display": "text",
      "display_template": "技術記事を取得しました。新規追加: {saved}件"
    },
    {
      "action": "tech_news_count",
      "prompt_hint": "技術記事件数確認（何件ある？合計は？全部で？）",
      "prompt_example": { "action": "tech_news_count", "source": null, "unread": false },
      "command": { "subcommands": [], "args": [] },
      "handler": "builtin:count_tech_news",
      "display": "text"
    },
    {
      "action": "tech_news_count_per_source",
      "prompt_hint": "技術記事ソース別件数（ソースごとに何件？各feedの件数は？）",
      "prompt_example": { "action": "tech_news_count_per_source" },
      "command": {
        "subcommands": ["sources", "count"],
        "args": []
      },
      "handler": "plugin",
      "display": "table",
      "display_field": "sources",
      "display_columns": ["name", "count", "enabled"]
    },
    {
      "action": "tech_news_sources_list",
      "prompt_hint": "技術記事ソース一覧（登録済みfeedを見せて）",
      "prompt_example": { "action": "tech_news_sources_list" },
      "command": { "subcommands": ["sources", "list"], "args": [] },
      "handler": "plugin",
      "display": "table",
      "display_field": "sources",
      "display_columns": ["name", "enabled", "category", "url"]
    },
    {
      "action": "tech_news_sources_add",
      "prompt_hint": "技術記事ソース追加（feedを登録・追加して）",
      "prompt_example": { "action": "tech_news_sources_add", "name": "ソース名", "url": "https://...", "category": null },
      "command": { "subcommands": [], "args": [] },
      "handler": "builtin:add_tech_news_source",
      "display": "text"
    },
    {
      "action": "tech_news_sources_update",
      "prompt_hint": "技術記事ソース更新（feedを有効化・無効化・URL変更）",
      "prompt_example": { "action": "tech_news_sources_update", "name": "ソース名", "url": null, "enabled": true, "category": null },
      "command": { "subcommands": [], "args": [] },
      "handler": "builtin:update_tech_news_source",
      "display": "text"
    },
    {
      "action": "tech_news_sources_delete",
      "prompt_hint": "技術記事ソース削除（feedを削除・登録解除して）",
      "prompt_example": { "action": "tech_news_sources_delete", "name": "ソース名" },
      "command": { "subcommands": [], "args": [] },
      "handler": "builtin:delete_tech_news_source",
      "display": "text"
    },
    {
      "action": "tech_news_categories_list",
      "prompt_hint": "技術記事カテゴリ一覧（カテゴリを見せて）",
      "prompt_example": { "action": "tech_news_categories_list" },
      "command": { "subcommands": [], "args": [] },
      "handler": "builtin:list_tech_news_categories",
      "display": "text"
    },
    {
      "action": "tech_news_categories_add",
      "prompt_hint": "技術記事カテゴリ追加（カテゴリを作って・追加して）",
      "prompt_example": { "action": "tech_news_categories_add", "name": "カテゴリ名" },
      "command": { "subcommands": [], "args": [] },
      "handler": "builtin:add_tech_news_category",
      "display": "text"
    },
    {
      "action": "tech_news_categories_rename",
      "prompt_hint": "技術記事カテゴリ名変更（カテゴリ名を変えて）",
      "prompt_example": { "action": "tech_news_categories_rename", "old_name": "旧名", "new_name": "新名" },
      "command": { "subcommands": [], "args": [] },
      "handler": "builtin:rename_tech_news_category",
      "display": "text"
    },
    {
      "action": "tech_news_categories_delete",
      "prompt_hint": "技術記事カテゴリ削除（カテゴリを削除して）",
      "prompt_example": { "action": "tech_news_categories_delete", "name": "カテゴリ名" },
      "command": { "subcommands": [], "args": [] },
      "handler": "builtin:delete_tech_news_category",
      "display": "text"
    },
    {
      "action": "tech_news_mark_read",
      "prompt_hint": "技術記事を既読にする（記事を既読に・読んだ・既読マークして）",
      "prompt_example": { "action": "tech_news_mark_read", "article_ids": [1, 2, 3] },
      "prompt_notes": "article_idsはtech_news_searchで取得した記事のid（整数）のリスト。",
      "command": { "subcommands": [], "args": [] },
      "handler": "builtin:mark_tech_news_read",
      "display": "text"
    },
    {
      "action": "tech_news_bookmark",
      "prompt_hint": "技術記事をブックマーク（ブックマークして・保存して・後で読む）",
      "prompt_example": { "action": "tech_news_bookmark", "article_ids": [1, 2, 3], "remove": false },
      "prompt_notes": "article_idsは記事idのリスト。remove:trueでブックマーク解除。",
      "command": { "subcommands": [], "args": [] },
      "handler": "builtin:bookmark_tech_news",
      "display": "text"
    }
  ]
}
